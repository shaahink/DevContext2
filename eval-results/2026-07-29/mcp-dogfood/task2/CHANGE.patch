+using System;
+using System.Diagnostics;
+using Hangfire.Annotations;
+using Hangfire.Common;
+using Hangfire.Logging;
+using Hangfire.Server;
+
+namespace Hangfire
+{
+    /// <summary>
+    /// Logs how long each background job took to perform, together with the
+    /// job identifier and the method that ran.
+    /// </summary>
+    /// <remarks>
+    /// The timer is started in <see cref="OnPerforming"/> and stashed in
+    /// <see cref="PerformContext.Items"/>, which is the only state that survives
+    /// between the two halves of a server filter.
+    /// </remarks>
+    public class LogJobDurationAttribute : JobFilterAttribute, IServerFilter
+    {
+        private const string StopwatchKey = "LogJobDurationStopwatch";
+
+        private readonly ILog _logger = LogProvider.For<LogJobDurationAttribute>();
+
+        public void OnPerforming([NotNull] PerformingContext context)
+        {
+            if (context == null) throw new ArgumentNullException(nameof(context));
+
+            context.Items[StopwatchKey] = Stopwatch.StartNew();
+        }
+
+        public void OnPerformed([NotNull] PerformedContext context)
+        {
+            if (context == null) throw new ArgumentNullException(nameof(context));
+
+            if (!context.Items.TryGetValue(StopwatchKey, out var value) || !(value is Stopwatch stopwatch))
+            {
+                // OnPerforming did not run for this job â€” nothing was timed.
+                return;
+            }
+
+            stopwatch.Stop();
+
+            _logger.InfoFormat(
+                "Job '{0}' ({1}.{2}) performed in {3} ms.",
+                context.BackgroundJob.Id,
+                context.BackgroundJob.Job.Type.ToGenericTypeString(),
+                context.BackgroundJob.Job.Method.Name,
+                stopwatch.ElapsedMilliseconds);
+        }
+    }
+}
