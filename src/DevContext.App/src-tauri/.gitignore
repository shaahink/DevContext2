# Generated by Cargo
# will have compiled files and executables
/target/
/gen/schemas

# dotnet publish output bundled as the sidecars — server + devcontext-mcp (pnpm publish:sidecars). The .gitkeep
# stays tracked so tauri-build's bundle.resources glob always matches (empty glob = hard error).
/resources/server/*
!/resources/server/.gitkeep
