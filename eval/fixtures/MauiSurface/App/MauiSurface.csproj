<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- Fixture (Prism D1.2b / audit B2): dotnet-podcasts' Mobile shape verbatim — the mobile TFM
         triple plus SDK-provided UseMaui, and NOT ONE Microsoft.Maui PackageReference. Package
         matching alone left MAUI invisible. -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MauiSurface</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
